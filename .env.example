# ==========================================
# The Vulpix Vault - Environment Variables
# ==========================================

# Google Gemini API key for AI card appraisal
GEMINI_API_KEY=your_gemini_api_key_here

# Gotify Push Notification Application Token
# (Generate this token in Gotify UI: http://<proxmox-ip>:8070 -> Apps -> Create App)
GOTIFY_APP_TOKEN=your_gotify_app_token_here

# Gotify Server URL (internal docker network address)
GOTIFY_URL=http://gotify:80

# SQLite Database Location inside container
DB_PATH=/data/vulpix_vault.db

# Scraping Schedule (Hours between automated runs)
SCRAPE_INTERVAL_HOURS=24

# eBay Search Queries
EBAY_SEARCH_QUERY=Vulpix graded (PSA, CGC, BGS, ARS)
