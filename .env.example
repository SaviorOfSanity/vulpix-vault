# ==========================================
# The Vulpix Vault v2 - Environment Variables
# ==========================================
# Tip: You can configure all eBay & Alert credentials either here
# OR directly inside the web UI (Auction Radar -> Setup & Alerts).

# SQLite Database Location inside container
DB_PATH=/data/vulpix_vault.db

# --- Phase 2: Official eBay Browse API (Free at developer.ebay.com) ---
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_ENV=production
EBAY_MARKETPLACE=EBAY_US

# --- Optional Push Alerts (Gotify / Discord / ntfy) ---
GOTIFY_URL=http://10.0.0.48:8070
GOTIFY_APP_TOKEN=
DISCORD_WEBHOOK_URL=
NTFY_URL=
